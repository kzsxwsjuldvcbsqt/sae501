- name: nrz2rz
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nBloc Python : conversion NRZ -> RZ (Annexe C, partie VII)\n\
      Entree 0 : signal NRZ\nEntree 1 : symbole '1' RZ repete  ([1]*N/2 + [0]*N/2)\n\
      Entree 2 : symbole '0' RZ repete  ([0]*N)\nSortie   : signal RZ\n\"\"\"\n\n\
      import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self, samp_rate=32000, clock=2000):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='NRZ to RZ',\n            in_sig=[np.float32,\
      \ np.float32, np.float32],\n            out_sig=[np.float32]\n        )\n  \
      \      self.samp_rate = samp_rate\n        self.clock = clock\n\n    def work(self,\
      \ input_items, output_items):\n        \"\"\"NRZ to RZ\"\"\"\n        for i\
      \ in range(0, len(input_items[0])):\n            if input_items[0][i] == 1:\n\
      \                output_items[0][i] = input_items[1][i]\n            else:\n\
      \                output_items[0][i] = input_items[2][i]\n        # output_items[0][:]\
      \ = np.where(input_items[0] == 1, input_items[1], input_items[2])\n        return\
      \ len(output_items[0])\n"
    affinity: ''
    alias: ''
    clock: clock
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: ('NRZ to RZ', 'blk', [('samp_rate', '32000'), ('clock', '2000')], [('0',
      'float', 1), ('1', 'float', 1), ('2', 'float', 1)], [('0', 'float', 1)], '',
      ['clock', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 384.0]
    rotation: 0
    state: enabled
